<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true"
    android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_logo_brand"
            android:contentDescription="ytrd" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <ImageButton android:id="@+id/open_files" android:layout_width="44dp"
            android:layout_height="44dp" android:src="@drawable/ic_folder"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Список файлов" />
        <ImageButton android:id="@+id/open_downloads" android:layout_width="44dp"
            android:layout_height="44dp" android:src="@drawable/ic_downloads_nav"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Активные загрузки" />
        <ImageButton android:id="@+id/open_settings" android:layout_width="44dp"
            android:layout_height="44dp" android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Настройки" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/fragment_container"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_marginBottom="@dimen/fab_margin"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_clear_selection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fab_secondary_margin_bottom"
                android:contentDescription="Отменить выделение"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/SecondaryFabShape"
                app:fabCustomSize="@dimen/fab_secondary_size"
                app:maxImageSize="@dimen/fab_secondary_icon_size"
                app:backgroundTint="@color/accent"
                app:tint="@android:color/white"
                app:srcCompat="@drawable/ic_close" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fab_secondary_margin_bottom"
                android:contentDescription="Выделить все"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/SecondaryFabShape"
                app:fabCustomSize="@dimen/fab_secondary_size"
                app:maxImageSize="@dimen/fab_secondary_icon_size"
                app:backgroundTint="@color/accent"
                app:tint="@android:color/white"
                app:srcCompat="@drawable/ic_done_all" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/add_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Добавить ссылку"
                app:backgroundTint="@color/accent"
                app:tint="@android:color/white"
                app:srcCompat="@drawable/ic_add" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
