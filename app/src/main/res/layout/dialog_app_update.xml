<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    tools:ignore="HardcodedText">

    <!-- Заголовок с иконкой обновления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_update"
            app:tint="@color/accent"
            android:contentDescription="Обновление" />

        <TextView
            android:id="@+id/dialog_update_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Доступно обновление"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Блок версий: текущая и новая -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/bg_version_info">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Установлена"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />

            <TextView
                android:id="@+id/txt_current_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.4.0"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/text_hint"
            android:contentDescription="->" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Новая версия"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />

            <TextView
                android:id="@+id/txt_new_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.4.1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_apk_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="59 МБ"
            android:textSize="12sp"
            android:textColor="@color/text_hint" />
    </LinearLayout>

    <!-- Список изменений -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Что нового:"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_changelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_update_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Описание изменений..."
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/btn_toggle_changelog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Полный список изменений ▾"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Секция прогресса скачивания (скрыта до нажатия кнопки Обновить) -->
    <LinearLayout
        android:id="@+id/layout_update_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <ProgressBar
            android:id="@+id/progress_update_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:indeterminate="false"
            android:progressTint="@color/accent"
            android:max="100" />

        <TextView
            android:id="@+id/txt_update_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Скачивание обновления…"
            android:textSize="12sp"
            android:textColor="@color/text_hint" />
    </LinearLayout>

    <!-- Кнопки действий: GitHub, Позже и Обновить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_github"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="GitHub"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_update_later"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Позже"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_update_now"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Обновить"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
