<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Удалить видео?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Запись будет удалена из списка."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:paddingTop="8dp"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- По левому краю: С файлом (акцентный цвет приложения, без рамок) -->
        <Button
            android:id="@+id/btn_delete_with_file"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="С файлом"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- По правому краю: ОК и Отмена ровно в линию -->
        <Button
            android:id="@+id/btn_ok"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="ОК"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btn_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Отмена"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>
</LinearLayout>
